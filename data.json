 "weekInBrief": [
  {
   "headline": "Prediction markets whipsaw on Huang's return",
   "body": "Polymarket's contract on Jensen Huang rejoining Nvidia by Nov 30 ran from about 4% to 99.8% by 9:01 AM ET Monday as the board announced his reinstatement, with $571,985 traded in 24 hours; over the weekend the same market had interim CEO Colette Kress at 9% and hyperscale chief Ian Buck at 17%.",
   "stamp": "Nov 23, 2026"
  },
  {
   "headline": "Huang's Dec 1 House interview is still on",
   "body": "Three House committees will hold a closed-door interview with Jensen Huang on December 1 over possible diversion of advanced chips to China, and the SEC's civil probe and California's review remain open \u2014 the reinstatement settles Nvidia's leadership question, not its regulatory ones.",
   "stamp": "Nov 23, 2026"
  },
  {
   "headline": "Voyager 1 is now a full light-day from Earth",
   "body": "NASA's Voyager 1, launched in 1977, has reached 16.1 billion miles from Earth \u2014 so distant that its radio signals, traveling at the speed of light, now take a full 24 hours to arrive, a first for any human-made object.",
   "stamp": "Nov 23, 2026"
  },
  {
   "headline": "Bank of Korea expected to hike again Thursday",
   "body": "The Bank of Korea meets Thursday, and economists expect another quarter-point rate hike, as Asian central banks stay on a tightening path even while governments move to support their stock markets after last week's rout.",
   "stamp": "Nov 23, 2026"
  }
 ],
 "hormuz": {
  "items": [
   {
    "headline": "Latest from the Strait",
    "body": "Iran is staging a test of the U.S. blockade: satellite imagery reported by United Against Nuclear Iran shows more than a dozen tankers gathered at Kharg Island, and on November 17 the sanctioned Suezmax Olym transferred about 200,000 barrels of Iranian crude to the unsanctioned tanker Hao Fan south of the island \u2014 the first ship-to-ship transfer of Iranian crude observed since the blockade resumed in July \u2014 though TankerTrackers and Windward caution that no convoy is actually underway. CENTCOM warned Wednesday that ships taking cargo at sea from vessels loaded at Iranian ports can themselves be treated as blockade violators, Tehran's foreign minister says Iran intends to break the blockade, and President Trump told Fox News he is inclined to resume strikes after the New Year if talks fail. On the oil itself, Kpler puts flows through the strait at about 9.5 million barrels a day over the 10 days through November 19, down from October's 12.2 million, while Iranian crude loadings remain at zero \u2014 the last Iranian cargoes discharged in China earlier this month, leaving no Iranian oil on the water outside the blockade."
   }
  ],
  "stats": ""
 },
 "space": [
  {
   "tag": "Space",
   "headline": "Oldest known quasar pair found shining at cosmic dawn",
   "body": "An international team using the James Webb Space Telescope and Gemini North has identified a pair of quasars \u2014 twin feeding black holes of enormous size \u2014 shining just 900 million years after the Big Bang, the oldest compact quasar pair known. Published in The Astrophysical Journal Letters, the pair's existence so early strains standard models of how fast black holes can grow.",
   "url": "https://gazewire.com/science-space/astronomers-identify-rare-quasar-pair-dating-to-cosmic-dawn"
  },
  {
   "tag": "Science",
   "headline": "Ancient 'stellar fossil' star preserves the early universe's chemistry",
   "body": "Astronomers at the Indian Institute of Astrophysics, using the Subaru Telescope in Hawaii, have found a rare ancient star carrying only about a thousandth of the Sun's iron yet rich in carbon and sodium \u2014 a chemical fingerprint of some of the first generations of stars. The results, in Monthly Notices of the Royal Astronomical Society, add a pristine fossil to the record of how the cosmos built its elements.",
   "url": "https://www.tbsnews.net/science/astronomers-discover-rare-ancient-star-preserving-clues-early-universe-1611941"
  },
  {
   "tag": "Science",
   "headline": "New algorithm finds a pulsar spinning 260 times a second",
   "body": "A Weizmann Institute algorithm that fills in the gaps left by a pulsar's orbital motion has cut the computing time for finding the fastest spinning stars from days to about 100 minutes \u2014 and promptly discovered PSR J1622-7204, a neutron star rotating more than 260 times per second. The method, in Physical Review Letters, is already hunting for more of these cosmic lighthouses, which double as laboratories for Einstein's relativity.",
   "url": "https://weizmann.org.au/2026/11/from-a-complex-problem-to-a-dizzying-discovery-a-new-method-for-finding-cosmic-lighthouses/"
  },
  {
   "tag": "Science",
   "headline": "A hidden 'Planet X2' beyond Neptune gets a concrete profile",
   "body": "New simulations give the solar system's hypothetical outer planet a testable shape: about 1.5 to 2 times Earth's mass on a distant, tilted, elliptical orbit whose gravity would explain the strange elongated orbits of icy bodies far beyond Neptune. The work, in Monthly Notices of the Royal Astronomical Society, sets up a target the Vera C. Rubin Observatory's sky survey can confirm or kill.",
   "url": "https://phys.org/news/2026-11-astronomers-hidden-planet-neptune.html"
  }
 ],
